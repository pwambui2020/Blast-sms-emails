generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  CUSTOMER
}

enum CampaignType {
  SMS
  EMAIL
}

enum CampaignStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum RecipientStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
}

enum CreditType {
  SMS
  EMAIL
}

enum TransactionType {
  BONUS
  PURCHASE
  CAMPAIGN
  REFUND
}

model User {
  id            String    @id @default(uuid())
  firstName     String
  lastName      String
  email         String    @unique
  password      String
  emailVerified Boolean   @default(false)
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles              UserRole[]
  refreshTokens      RefreshToken[]
  credits            Credit?
  contacts           Contact[]
  contactLists       ContactList[]
  campaigns          Campaign[]
  creditTransactions CreditTransaction[]
  auditLogs          AuditLog[]
  setting            Setting?
  templates          Template[]

  @@index([email])
}

model Role {
  id   String   @id @default(uuid())
  name RoleName @unique

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: SetNull)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

model Credit {
  id           String @id @default(uuid())
  smsCredits   Int    @default(100)
  emailCredits Int    @default(100)

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CreditTransaction {
  id           String          @id @default(uuid())
  type         TransactionType
  creditType   CreditType
  amount       Int
  balanceAfter Int
  reason       String
  createdAt    DateTime        @default(now())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model Contact {
  id        String  @id @default(uuid())
  phone     String?
  email     String?
  firstName String?
  lastName  String?
  company   String?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: SetNull)

  contactLists ContactListMember[]
  recipients   CampaignRecipient[]

  @@unique([userId, phone])
  @@unique([userId, email])
  @@index([userId])
  @@index([phone])
  @@index([email])
}

model ContactList {
  id          String  @id @default(uuid())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: SetNull)

  contacts ContactListMember[]

  @@unique([userId, name])
  @@index([userId])
}

model ContactListMember {
  contactId String
  listId    String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  list ContactList @relation(fields: [listId], references: [id], onDelete: Restrict)

  @@id([contactId, listId])
  @@index([listId])
}

model Template {
  id        String       @id @default(uuid())
  name      String
  type      CampaignType
  subject   String?
  message   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: SetNull)

  campaigns Campaign[]

  @@unique([userId, name])
  @@index([userId])
}

model Campaign {
  id          String         @id @default(uuid())
  name        String
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  subject     String?
  message     String
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     String
  templateId String?

  user User @relation(fields: [userId], references: [id], onDelete: SetNull)

  template Template? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  recipients CampaignRecipient[]

  @@index([userId])
  @@index([userId, status])
  @@index([type])
  @@index([status])
}

model CampaignRecipient {
  id                String          @id @default(uuid())
  status            RecipientStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())

  campaignId String
  contactId  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
}

model Setting {
  id                 String  @id @default(uuid())
  theme              String  @default("light")
  timezone           String  @default("Africa/Nairobi")
  language           String  @default("en")
  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(true)

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: SetNull)
}
